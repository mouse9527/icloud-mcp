+// loadPlainConfig serves cleartext HTTP for a private cluster network where
+// TLS and identity are enforced in front of this process (NetworkPolicy plus
+// the MCP client's own access control). It never falls back silently: it is
+// selected only by MCP_PLAIN_HTTP=true and requires an explicit Host allowlist.
+func loadPlainConfig(address string) (*remoteConfig, error) {
+	c := &remoteConfig{address: address, plain: true, allowedHosts: map[string]bool{}}
+	for _, h := range strings.Split(os.Getenv("MCP_ALLOWED_HOSTS"), ",") {
+		if h = strings.TrimSpace(h); h != "" {
+			c.allowedHosts[h] = true
+		}
+	}
+	if len(c.allowedHosts) == 0 {
+		return nil, errors.New("MCP_PLAIN_HTTP requires MCP_ALLOWED_HOSTS")
+	}
+	if path := os.Getenv("MCP_BEARER_TOKEN_FILE"); path != "" {
+		b, e := os.ReadFile(path)
+		if e != nil || len(b) > 4096 {
+			return nil, errors.New("cannot read MCP bearer token file")
+		}
+		if c.bearer = strings.TrimSpace(string(b)); c.bearer == "" {
+			return nil, errors.New("empty MCP bearer token")
+		}
+	}
+	return c, nil
+}

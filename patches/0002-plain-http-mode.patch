index 0000000..872f924
--- /dev/null
+++ b/cmd/icloud-mcp/remote_plain_test.go
@@ -0,0 +1,75 @@
+package main
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/ThomasCrouzet/icloud-mcp/internal/security"
+	"github.com/mark3labs/mcp-go/mcp"
+)
+
+func TestPlainRemote(t *testing.T) {
+	dir := t.TempDir()
+	tokenFile := filepath.Join(dir, "token")
+	os.WriteFile(tokenFile, []byte("synthetic-bearer\n"), 0o600)
+	t.Setenv("MCP_PLAIN_HTTP", "true")
+	t.Setenv("MCP_ALLOWED_HOSTS", "mcp.internal:8080, mcp:8080")
+	t.Setenv("MCP_BEARER_TOKEN_FILE", tokenFile)
+	c, err := loadRemoteConfig(":8080")
+	if err != nil || !c.plain || c.bearer != "synthetic-bearer" || !c.allowedHosts["mcp:8080"] {
+		t.Fatalf("plain config: %v %+v", err, c)
+	}
+	s := newMCPServer(security.NewRedactor())
+	s.AddTool(mcp.NewTool("fixture"), func(context.Context, mcp.CallToolRequest) (*mcp.CallToolResult, error) {
+		return mcp.NewToolResultText("synthetic-result"), nil
+	})
+	h := remoteHandler(s, c)
+	do := func(host, auth, origin, path string) *httptest.ResponseRecorder {
+		r := httptest.NewRequest("POST", "http://"+host+path, strings.NewReader(`{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"fixture","arguments":{}}}`))
+		r.Header.Set("Content-Type", "application/json")
+		r.Header.Set("Accept", "application/json, text/event-stream")
+		if auth != "" {
+			r.Header.Set("Authorization", auth)
+		}
+		if origin != "" {
+			r.Header.Set("Origin", origin)
+		}
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		return w
+	}
+	if w := do("mcp.internal:8080", "Bearer synthetic-bearer", "", "/mcp"); w.Code != 200 || !strings.Contains(w.Body.String(), "synthetic-result") {
+		t.Fatalf("authorized call: %d %s", w.Code, w.Body)
+	}
+	cases := []struct {
+		host, auth, origin, path string
+		want                     int
+	}{
+		{"evil:8080", "Bearer synthetic-bearer", "", "/mcp", 403},
+		{"mcp:8080", "", "", "/mcp", 401},
+		{"mcp:8080", "Bearer wrong", "", "/mcp", 401},
+		{"mcp:8080", "Bearer synthetic-bearer", "http://evil", "/mcp", 403},
+		{"mcp:8080", "Bearer synthetic-bearer", "", "/other", 404},
+	}
+	for _, tc := range cases {
+		if w := do(tc.host, tc.auth, tc.origin, tc.path); w.Code != tc.want {
+			t.Errorf("%+v: got %d", tc, w.Code)
+		}
+	}
+	r := httptest.NewRequest("GET", "http://mcp:8080/healthz", nil)
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if w.Code != 200 {
+		t.Errorf("healthz %d", w.Code)
+	}
+	t.Setenv("MCP_ALLOWED_HOSTS", "")
+	if _, err := loadRemoteConfig(":8080"); err == nil {
+		t.Error("plain mode without host allowlist must fail")
+	}
+	_ = http.StatusOK
+}

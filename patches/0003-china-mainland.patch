+++ b/internal/security/china_test.go
@@ -0,0 +1,42 @@
+package security
+
+import "testing"
+
+// icloud-mcp patch: China mainland entry point and Contacts hosts.
+func TestCalDAVBaseURL(t *testing.T) {
+	for _, tc := range []struct {
+		env, want string
+		ok        bool
+	}{
+		{"", ICloudBaseURL, true},
+		{"https://caldav.icloud.com", ICloudBaseURL, true},
+		{"https://caldav.icloud.com.cn", ICloudChinaBaseURL, true},
+		{"https://caldav.icloud.com.cn/", "", false},
+		{"http://caldav.icloud.com.cn", "", false},
+		{"https://evil.example", "", false},
+		{"https://p212-caldav.icloud.com.cn", "", false},
+	} {
+		t.Setenv(CalDAVBaseURLEnv, tc.env)
+		got, err := CalDAVBaseURL()
+		if (err == nil) != tc.ok || got != tc.want {
+			t.Errorf("%q: got %q err=%v", tc.env, got, err)
+		}
+	}
+}
+
+func TestIsContactsHostChina(t *testing.T) {
+	for host, want := range map[string]bool{
+		"contacts.icloud.com.cn":           true,
+		"p212-contacts.icloud.com.cn":      true,
+		"p212-contacts.icloud.com.cn.evil": false,
+		"P212-CONTACTS.ICLOUD.COM.CN":      false,
+		"p212-caldav.icloud.com.cn":        false,
+	} {
+		if got := IsContactsHost(host); got != want {
+			t.Errorf("IsContactsHost(%q) = %v, want %v", host, got, want)
+		}
+	}
+	if IsICloudHost("p212-contacts.icloud.com.cn") {
+		t.Error("calendar allowlist must not admit contacts hosts")
+	}
+}

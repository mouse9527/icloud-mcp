+// ICloudChinaBaseURL is the China mainland (icloud.com.cn) Calendar entry
+// point. icloud-mcp patch: China accounts are served from *.icloud.com.cn shards.
+const ICloudChinaBaseURL = "https://caldav.icloud.com.cn"
+
+// CalDAVBaseURLEnv selects the Calendar entry point. Only the two Apple
+// values are accepted; anything else is a configuration error.
+const CalDAVBaseURLEnv = "ICLOUD_CALDAV_BASE_URL"
+
+// CalDAVBaseURL returns the configured Calendar entry point (default
+// ICloudBaseURL). It never accepts an arbitrary URL.
+func CalDAVBaseURL() (string, error) {
+	switch v := os.Getenv(CalDAVBaseURLEnv); v {
+	case "", ICloudBaseURL:
+		return ICloudBaseURL, nil
+	case ICloudChinaBaseURL:
+		return ICloudChinaBaseURL, nil
+	default:
+		return "", fmt.Errorf("%s must be %s or %s", CalDAVBaseURLEnv, ICloudBaseURL, ICloudChinaBaseURL)
+	}
+}
